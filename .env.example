PORT=47231
HOST=0.0.0.0
SESSION_SECRET=
DB_PATH=./data/ptc.sqlite
APP_TIMEZONE=Asia/Bangkok
COOKIE_SECURE=false

# Google Workspace sign-in. Leave blank to use the local email sign-in fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_HOSTED_DOMAIN=nis.ac.th

# true or false. When unset, local email sign-in is on only if Google is not configured.
ALLOW_LOCAL_AUTH=
ROLE_MAP_PATH=./config/roles.json

# PowerSchool. Leave blank to use the built-in teacher stand-in.
PSAPI_BASE_URL=
PSAPI_CLIENT_ID=
PSAPI_CLIENT_SECRET=
PSAPI_TEACHERS_PATH=/ws/schema/table/teachers
PSAPI_STUDENTS_PATH=/ws/schema/table/students

# Verification email. Leave SMTP_HOST blank to log codes and, outside production,
# include dev_code in the send-code response so the verify page can be used locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=conferences@nis.ac.th
