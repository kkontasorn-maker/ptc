PORT=47231
HOST=0.0.0.0
SESSION_SECRET=
DB_PATH=./data/ptc.sqlite
APP_TIMEZONE=Asia/Bangkok
COOKIE_SECURE=false

# Google Workspace sign-in. Leave blank to use the local email sign-in fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_HOSTED_DOMAIN=nis.ac.th

# true or false. When unset, local email sign-in is on only if Google is not configured.
ALLOW_LOCAL_AUTH=
ROLE_MAP_PATH=./config/roles.json

# PowerSchool. Leave blank to use the built-in teacher stand-in.
# A live guardian match walks emailaddress → personemailaddressassoc →
# studentcontactassoc → studentcontactdetail (isactive=1), then loads
# students by dcid. PSAPI_STUDENTS_PATH is that students table.
PSAPI_BASE_URL=
PSAPI_CLIENT_ID=
PSAPI_CLIENT_SECRET=
PSAPI_TEACHERS_PATH=/ws/schema/table/teachers
PSAPI_STUDENTS_PATH=/ws/schema/table/students

# Verification email. Leave SMTP_HOST blank to log codes and, outside production,
# include dev_code in the send-code response so the verify page can be used locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=conferences@nis.ac.th

# Email safety. Comma-separated. Independent of NODE_ENV and ALLOW_LOCAL_AUTH.
# When set, a recipient on the list gets the real message. Anyone else is
# redirected to the first address, with the real recipient and original
# subject prepended. Messages are never dropped.
# Set this in every environment except a real pilot or production deploy.
# Unset it only when real parents and teachers should receive real email.
EMAIL_ALLOWLIST=you@nis.ac.th

# Delivery webhooks. Leave EMAIL_WEBHOOK_PROVIDER empty until an ESP is
# provisioned. POST /api/v1/webhooks/email-status then returns 401.
# Set both values together. Supported adapters:
#   hmac      Generic. Header X-Email-Webhook-Signature is hex HMAC-SHA256
#             of the raw body using EMAIL_WEBHOOK_SECRET. JSON body:
#             { provider_message_id, status, status_detail }
#             status: delivered | bounced | complained | unknown | sent
#   postmark  Header X-Postmark-Webhook-Token equals the secret, or that
#             header is the same HMAC. Body uses Postmark RecordType
#             (Delivery, Bounce, SpamComplaint) and MessageID.
#   mailgun   JSON signature.timestamp + signature.token HMAC-SHA256,
#             compared with signature.signature. event-data.event maps
#             delivered / failed / complained.
#   sendgrid  Twilio signed-event webhook. EMAIL_WEBHOOK_SECRET is the
#             ECDSA public key (PEM). Headers are
#             X-Twilio-Email-Event-Webhook-Signature and
#             X-Twilio-Email-Event-Webhook-Timestamp.
#   ses       HMAC of the raw body in X-Email-Webhook-Signature, same as
#             hmac. Body is an SES notification, or an SNS Notification
#             whose Message is that JSON. This adapter does not verify
#             SNS signing certificates. Plain SMTP without a message id
#             never matches a webhook; those rows stay status sent.
EMAIL_WEBHOOK_PROVIDER=
EMAIL_WEBHOOK_SECRET=

# Hours before a still-sent row with no status update counts as unconfirmed.
# Unset means 24.
DELIVERY_ISSUE_STALE_HOURS=24

# Post-cutoff summary. The server checks once at startup, then on this interval.
# 0 runs the check at startup only. Unset means every 60 seconds.
SUMMARY_INTERVAL_MS=60000
